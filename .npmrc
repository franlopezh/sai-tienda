# Configuración npm para SAI Shop
# Hardening de seguridad y reproducibilidad

# Cuando agreguemos paquetes nuevos, fijar la versión exacta (sin ^).
# Evita drift inesperado entre installs.
save-exact=true

# Siempre usar package-lock.json. Rechazar instalación si no hay lockfile
# o si está desincronizado con package.json.
package-lock=true

# Esconder mensajes de "fund this project" al instalar. Limpieza visual.
fund=false

# Nivel mínimo de severidad para reportar en npm audit. moderate es buen balance:
# - low: ruido por vulnerabilidades teóricas que casi nunca aplican.
# - moderate: lo que realmente vale revisar.
audit-level=moderate

# Bloquear automáticamente paquetes con scripts en pre/post-install
# para cualquier paquete que agreguemos. Si un paquete legítimo requiere
# scripts (ej. esbuild, sharp), se permite explícitamente con --foreground-scripts.
# Comentado por ahora porque Next.js necesita SWC bindings al instalar.
# ignore-scripts=true
